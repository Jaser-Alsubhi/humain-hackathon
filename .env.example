# Copy to .env and fill in. Never commit .env.

# LLM used by the recovery agent (any OpenAI-compatible endpoint).
# The results in this repo were produced with gpt-oss-120b on Cerebras.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b
LLM_TIMEOUT=30
# Optional: comma-separated fallback models, tried in order.
# LLM_LADDER=

# Database password for the local Docker Compose stack.
DB_PASSWORD=devpassword

# Live "Break it" server (only needed on the deployed VM).
# LIVE_BIND=172.17.0.1
# LIVE_PORT=8100
# LIVE_DOMAIN=your-domain.example
# LIVE_DAILY_CAP=25
